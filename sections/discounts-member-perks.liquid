{% style %}
.luxury-wrapper {
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  background: #f8f8f8;
}

@media (max-width: 767px) {
  .luxury-wrapper {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
}

.luxury-container {
  max-width: 1200px;
  margin: auto;
  text-align: center;
}

.luxury-heading {
  font-size: 42px;
  font-weight: 700;
  margin-bottom: 18px;
  letter-spacing: -0.5px;
}

.luxury-subtext {
  max-width: 720px;
  margin: 0 auto 50px;
  color: #555;
  font-size: 18px;
  line-height: 1.6;
}

/* Luxury Grid */
.luxury-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 35px;
  margin-bottom: 60px;
}

@media (max-width: 767px) {
  .luxury-grid {
    grid-template-columns: 1fr;
  }
}

/* Luxury Card */
.luxury-card {
  position: relative;
  border-radius: 14px;
  overflow: hidden;
  min-height: 330px;
  display: flex;
  align-items: flex-end;
  color: white;
  text-align: left;
  background-size: cover;
  background-position: center;
  box-shadow: 0 6px 20px rgba(0,0,0,0.12);
}

.luxury-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.75) 100%);
}

.luxury-card-content {
  position: relative;
  padding: 25px;
  z-index: 2;
}

.luxury-card h3 {
  font-size: 26px;
  font-weight: 700;
  margin-bottom: 12px;
}

.luxury-card ul {
  list-style: none;
  padding-left: 0;
}

.luxury-card li {
  margin-bottom: 6px;
  font-size: 15px;
  opacity: 0.9;
}

/* Carousel */
.luxury-carousel-title {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 20px;
}

.luxury-carousel {
  display: flex;
  gap: 25px;
  overflow-x: auto;
  padding-bottom: 10px;
  scroll-snap-type: x mandatory;
}

.luxury-carousel-item {
  min-width: 240px;
  background: white;
  border-radius: 12px;
  overflow: hidden;
  scroll-snap-align: start;
  box-shadow: 0 5px 18px rgba(0,0,0,0.08);
}

.luxury-carousel-item img {
  width: 100%;
  height: 150px;
  object-fit: cover;
}

.luxury-carousel-item p {
  padding: 14px;
  font-size: 15px;
  color: #333;
}
{% endstyle %}


<section class="luxury-wrapper">
  <div class="luxury-container">

    <h2 class="luxury-heading">{{ section.settings.heading }}</h2>

    <p class="luxury-subtext">{{ section.settings.subtext }}</p>

    <!-- Luxury Cards -->
    <div class="luxury-grid">
      {% for block in section.blocks %}
        {% if block.type == 'tier' %}
          <div 
            class="luxury-card"
            style="background-image: url('{{ block.settings.background | image_url: width: 800 }}')"
          >
            <div class="luxury-card-content">
              <h3>{{ block.settings.title }}</h3>

              <ul>
                {% for i in (1..6) %}
                  {% assign perk = 'perk_' | append: i %}
                  {% if block.settings[perk] != blank %}
                    <li>{{ block.settings[perk] }}</li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Luxury Carousel -->
    {% assign has_carousel = false %}
    {% for block in section.blocks %}
      {% if block.type == 'carousel_item' %}
        {% assign has_carousel = true %}
      {% endif %}
    {% endfor %}

    {% if has_carousel %}
      <h3 class="luxury-carousel-title">{{ section.settings.carousel_title }}</h3>

      <div class="luxury-carousel">
        {% for block in section.blocks %}
          {% if block.type == 'carousel_item' %}
            <div class="luxury-carousel-item">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 400 }}" alt="Discount offer">
              {% endif %}
              <p>{{ block.settings.caption }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "Luxury Member Perks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium Member Perks"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Exclusive benefits curated for our most loyal members."
    },
    {
      "type": "text",
      "id": "carousel_title",
      "label": "Carousel Title",
      "default": "Exclusive Partner Deals"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "tier",
      "name": "Luxury Tier Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "background",
          "label": "Background Image"
        },
        { "type": "text", "id": "title", "label": "Tier Title" },
        { "type": "text", "id": "perk_1", "label": "Perk 1" },
        { "type": "text", "id": "perk_2", "label": "Perk 2" },
        { "type": "text", "id": "perk_3", "label": "Perk 3" },
        { "type": "text", "id": "perk_4", "label": "Perk 4" },
        { "type": "text", "id": "perk_5", "label": "Perk 5" },
        { "type": "text", "id": "perk_6", "label": "Perk 6" }
      ]
    },
    {
      "type": "carousel_item",
      "name": "Carousel Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Offer Image" },
        { "type": "text", "id": "caption", "label": "Offer Caption" }
      ]
    }
  ],

  "presets": [
    {
      "name": "Luxury Member Perks"
    }
  ]
}
{% endschema %}
