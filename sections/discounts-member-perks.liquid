{% style %}
.luxury-wrapper {
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  background: #f8f8f8;
}

@media (max-width: 767px) {
  .luxury-wrapper {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
}


{% endstyle %}


<section class="luxury-wrapper">
  <div class="luxury-container page-width">

    <h2 class="luxury-heading">{{ section.settings.heading }}</h2>

    <p class="luxury-subtext">{{ section.settings.subtext }}</p>

    <!-- Luxury Cards -->
    <div class="luxury-grid">
      {% for block in section.blocks %}
        {% if block.type == 'tier' %}
          <div 
            class="luxury-card"
            style="background-image: url('{{ block.settings.background | image_url: width: 800 }}')"
          >
            <div class="luxury-card-content">
              <h3>{{ block.settings.title }}</h3>

              <ul>
                {% for i in (1..6) %}
                  {% assign perk = 'perk_' | append: i %}
                  {% if block.settings[perk] != blank %}
                    <li>{{ block.settings[perk] }}</li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Luxury Member Perks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium Member Perks"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Exclusive benefits curated for our most loyal members."
    },
    {
      "type": "text",
      "id": "carousel_title",
      "label": "Carousel Title",
      "default": "Exclusive Partner Deals"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "tier",
      "name": "Luxury Tier Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "background",
          "label": "Background Image"
        },
        { "type": "text", "id": "title", "label": "Tier Title" },
        { "type": "text", "id": "perk_1", "label": "Perk 1" },
        { "type": "text", "id": "perk_2", "label": "Perk 2" },
        { "type": "text", "id": "perk_3", "label": "Perk 3" },
        { "type": "text", "id": "perk_4", "label": "Perk 4" },
        { "type": "text", "id": "perk_5", "label": "Perk 5" },
        { "type": "text", "id": "perk_6", "label": "Perk 6" }
      ]
    }
  ],

  "presets": [
    {
      "name": "Luxury Member Perks"
    }
  ]
}
{% endschema %}
