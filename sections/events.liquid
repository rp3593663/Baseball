{% style %}
  .events-section {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  @media (max-width: 767px) {
    .events-section {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section class="events-section {{ section.settings.custom_class }}">
  <div class="page-width">
    <div class="events_header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.description }}</p>
    </div>

    <div class="events-wrapper">
      {% for block in section.blocks %}
        <div class="event-item">
          <div class="event_image">
            {% if block.settings.event_image %}
              <img src="{{ block.settings.event_image | img_url: '800x' }}" alt="{{ block.settings.event_title }}">
            {% endif %}
          </div>

          <div class="event_content">
            <h2 class="event_title">{{ block.settings.event_title }}</h2>

            {% if block.settings.event_description %}
              <div class="event_desc">{{ block.settings.event_description }}</div>
            {% endif %}
          </div>

          <div class="events_info">

            {% if block.settings.event_cost %}
              <div class="event_cost">{{ block.settings.event_cost }}</div>
            {% endif %}

            <div class="evens_all_meta">

              {% if block.settings.event_date %}
                <div class="event_meta">
                  <svg width="24" height="24" viewBox="0 0 24 24"><path d="M16.7502 3.56V2C16.7502 1.59 16.4102 1.25 16.0002 1.25C15.5902 1.25 15.2502 1.59 15.2502 2V3.5H8.75023V2C8.75023 1.59 8.41023 1.25 8.00023 1.25C7.59023 1.25 7.25023 1.59 7.25023 2V3.56C4.55023 3.81 3.24023 5.42 3.04023 7.81C3.02023 8.1 3.26023 8.34 3.54023 8.34H20.4602C20.7502 8.34 20.9902 8.09 20.9602 7.81C20.7602 5.42 19.4502 3.81 16.7502 3.56Z" fill="#FFFFFF"/><path d="M20 9.83984H4C3.45 9.83984 3 10.2898 3 10.8398V16.9998C3 19.9998 4.5 21.9998 8 21.9998H16C19.5 21.9998 21 19.9998 21 16.9998V10.8398C21 10.2898 20.55 9.83984 20 9.83984ZM9.21 18.2098..."/></svg>
                  {{ block.settings.event_date }}
                </div>
              {% endif %}

              {% if block.settings.event_location %}
                <div class="event_meta">
                  <svg width="24" height="24"><path d="M20.6191 8.45C19.5691 3.83 15.5391 1.75 11.9991 1.75..."/></svg>
                  {{ block.settings.event_location }}
                </div>
              {% endif %}

              {% if block.settings.event_contact != blank %}
                <div class="event_meta">
                  <svg width="24" height="24"><path d="M17 3.5H7C4 3.5 2 5 2 8.5V15.5C2 19..."/></svg>
                  {{ block.settings.event_contact }}
                </div>
              {% endif %}
            </div>

            {%- comment -%}
              MEMBERSHIP BUTTON LOGIC
              Supports: one tag or multiple tags separated by commas
            {%- endcomment -%}

            {% assign required_tags = block.settings.event_member_tags | downcase | split: "," %}

            {%- assign cleaned_tags = "" | split: "" -%}
            {% for t in required_tags %}
              {% assign cleaned_tag = t | strip %}
              {% assign cleaned_tags = cleaned_tags | push: cleaned_tag %}
            {% endfor %}

            {% assign show_button = false %}

            {% if customer %}
              {% for tag in customer.tags %}
                {% assign customer_tag = tag | downcase %}
                {% if cleaned_tags contains customer_tag %}
                  {% assign show_button = true %}
                {% endif %}
              {% endfor %}
            {% endif %}

            {% if show_button and block.settings.button_label and block.settings.button_link %}
              <a href="{{ block.settings.button_link }}" class="event_btn btn">
                {{ block.settings.button_label }}
              </a>
            {% endif %}

          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Events",
  "settings": [
    { "type": "text", "id": "custom_class", "label": "Custom CSS Class" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding Top (Desktop)", "default": 80 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding Bottom (Desktop)", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 200, "step": 5, "label": "Padding Top (Mobile)", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 200, "step": 5, "label": "Padding Bottom (Mobile)", "default": 40 }
  ],

  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "image_picker", "id": "event_image", "label": "Event Image" },
        { "type": "text", "id": "event_title", "label": "Event Title" },
        { "type": "html", "id": "event_description", "label": "Description" },
        { "type": "text", "id": "event_date", "label": "Event Date" },
        { "type": "text", "id": "event_location", "label": "Location" },
        { "type": "richtext", "id": "event_contact", "label": "Contact" },
        { "type": "text", "id": "event_cost", "label": "Cost" },
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "Learn More" },
        { "type": "url", "id": "button_link", "label": "Button Link" },

        {
          "type": "text",
          "id": "event_member_tags",
          "label": "Required Member Tags (comma-separated)",
          "info": "Example: premier_member_monthly OR elite_member_yearly, premier_member_yearly"
        }
      ]
    }
  ],

  "presets": [
    { "name": "Events" }
  ]
}
{% endschema %}
